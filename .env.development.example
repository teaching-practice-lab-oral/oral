# Local Docker Compose settings. Copy to .env, then generate SECRET_KEY before startup.
POSTGRES_USER=meet
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=meetdb
DATABASE_URL=postgresql://meet:local-development-only@db:5432/meetdb

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:7683
CORS_ORIGINS=http://localhost:7683
TRUSTED_HOSTS=localhost,127.0.0.1

# Optional integrations. Features that need them remain unavailable until configured.
OPENAI_API_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
OCI_ENDPOINT_URL=
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
OCI_BUCKET_NAME=
OCI_REGION=
