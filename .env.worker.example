# CHT/Taiwan stateless worker VM settings.
# This file is for the Raspberry Pi worker, not the main app.

APP_ENV=production
WORKER_ONLY=true
MEET_IMAGE=your-registry/meet@sha256:replace-with-built-image-digest
OPENAI_API_KEY=sk-...

OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
TTS_SPEED=0.95
TTS_MAX_CONCURRENCY=4

# 50 MiB raw audio expands to roughly 67 MiB as base64 JSON.
WORKER_MAX_REQUEST_BODY_BYTES=75497472
WORKER_MAX_TTS_CHARS=20000
WORKER_MAX_AUDIO_BASE64_CHARS=70000000

# Generate once with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Use the same value as the main app's CHT_WORKER_SECRET.
CHT_WORKER_SECRET=
GUNICORN_WORKERS=2
FORWARDED_ALLOW_IPS=127.0.0.1
TUNNEL_TOKEN=your-cloudflare-tunnel-token
