# CHT/Taiwan stateless worker settings.
# Copy to .env.worker, replace every placeholder, and keep that file private.
# Start it with:
# docker compose --env-file .env.worker -f docker-compose-worker.yml up -d

# Compose inputs. Always deploy an immutable image digest shared with the web app.
MEET_IMAGE=registry.example.com/meet@sha256:replace-with-image-digest
APP_ENV_FILE=.env.worker

APP_ENV=production
WORKER_ONLY=true

# OpenAI credentials and models used by the worker.
OPENAI_API_KEY=replace-with-worker-openai-api-key
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# The roleplay/shadowing voices, instructions, and 1.0x speed are code-owned
# SpeechProfile settings. Do not add the removed TTS_VOICE or TTS_SPEED values.
TTS_MAX_CONCURRENCY=4
AUDIO_PROCESSING_MAX_CONCURRENCY=4
MAX_AUDIO_SECONDS=300

# Must exactly match CHT_WORKER_SECRET on the stage web app. Generate with:
# openssl rand -hex 32
CHT_WORKER_SECRET=replace-with-64-character-random-hex-secret

# Worker process and trusted reverse-proxy settings.
GUNICORN_WORKERS=2
FORWARDED_ALLOW_IPS=127.0.0.1
